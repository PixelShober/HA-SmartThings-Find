[Unit]
Description=SmartThings Find login bot (keeps the HA web session alive)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stfbot
WorkingDirectory=/opt/stf-bot
# headed on a virtual display: headless Chromium triggers reCAPTCHA
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1920x1080x24" /opt/stf-bot/venv/bin/python /opt/stf-bot/stf_login.py --ha --timeout 180
TimeoutStartSec=600
